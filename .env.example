# Copy to .env.local for local overrides. Leave both empty for normal local dev —
# the Vite proxy then sends /api and /socket.io to http://localhost:5000.

# Backend origin, e.g. https://si-inventory-backend.onrender.com
VITE_API_URL=

# Public frontend address encoded in the store QR code, e.g. https://si-inventory.vercel.app
VITE_PUBLIC_URL=
