# Used by `vite build` (Vercel). Not secret — these end up in the browser bundle.

# The Render backend. No trailing slash, no /api.
VITE_API_URL=https://si-inventory-backend.onrender.com

# The Vercel frontend's final address, so the printed QR code always points there.
# Fill in once the production domain is known, e.g. https://si-inventory.vercel.app
VITE_PUBLIC_URL=https://si-inventory.vercel.app
